{
    "name": "google-maps-scraper",
    "version": "1.0.0",
    "type": "module",
    "description": "Production-grade, standalone Google Maps scraper built with TypeScript, Crawlee, and Playwright. Extracts business info, emails, phones, reviews, and coordinates locally.",
    "engines": {
        "node": ">=20"
    },
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "ui": "tsx src/server.ts",
        "web": "tsx src/server.ts",
        "scrape": "tsx src/main.ts",
        "start:dev": "tsx src/main.ts",
        "start:prod": "node dist/main.js",
        "start": "npm run ui",
        "export": "tsx src/export.ts",
        "lint": "eslint src/",
        "format": "prettier --write src/"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "crawlee": "^3.12.1",
        "express": "^5.3.0",
        "playwright": "^1.49.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    },
    "license": "ISC",
    "author": ""
}
